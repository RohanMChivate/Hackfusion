# Copy to server/.env and fill in. Leave ANTHROPIC_API_KEY empty to keep AI review off
# (with it set, alert screenshots and alert summaries are sent to the Claude API, outside the LAN).
ANTHROPIC_API_KEY=
# Optional: model for alert review and report summaries (default claude-opus-5-5)
# INVIGILAI_AI_MODEL=claude-opus-5-5
